{
  "name": "majung",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @majung/web",
    "dev:web:https": "npm run dev:https -w @majung/web",
    "dev:server": "npm run dev -w @majung/server",
    "e2e:vehicle": "node apps/vehicle/e2e/vehicle-flows.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
