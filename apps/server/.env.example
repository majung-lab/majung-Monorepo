PORT=4000
DB_PATH=./data/majung.sqlite
# 카카오 개발자 콘솔 > 앱 키 > REST API 키 (없으면 '지도에서 고른 위치'로 표시)
KAKAO_REST_KEY=
# 문자 초대: console = 실제로 보내지 않고 서버 터미널에 내용만 찍는다 (발송 업체 연동 전 기본값)
SMS_PROVIDER=console
# 문자에 담는 동승자 웹 주소. 받는 휴대폰에서 열려야 하므로 PC의 LAN IP나 배포 주소로
PASSENGER_WEB_URL=http://localhost:5173
# 날씨: 공공데이터포털 '기상청_단기예보 조회서비스' 인증키 (인코딩/디코딩 키 아무거나). 없으면 날씨 없이 걷는 시간 순으로만 추천
KMA_SERVICE_KEY=
# 키 없이 시연할 때: rain = 늘 '곧 비'(지붕 있는 곳 추천), clear = 늘 맑음. 키가 있으면 무시
WEATHER_DEMO=
